# Copy to .env. Keep credentials on the server; never use a VITE_ prefix for secrets.
PORT=3001
# For public HTTPS deployments, uncomment these and set your exact origin.
# NODE_ENV=production
# APP_ORIGIN=https://medicine.example.com

# Optional: real image recognition. Without a key, manual entry remains available.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: VAPID keys are generated and persisted in data/keys.json on first start.
# Set this to your own contact email for a production deployment.
VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# DB_PATH=./data/medications.sqlite
# VAPID_KEYS_PATH=./data/keys.json
